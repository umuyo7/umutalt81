FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libfreetype6-dev libjpeg62-turbo-dev libpng-dev libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql gd mbstring \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

COPY catering-php/ /var/www/html/
RUN mkdir -p /var/www/html/includes/session_data \
    && chown -R www-data:www-data /var/www/html/includes/session_data \
    && chmod 700 /var/www/html/includes/session_data

EXPOSE 80
