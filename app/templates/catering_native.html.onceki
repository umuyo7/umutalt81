{% macro hidden(action, id=0) -%}<input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="{{ action }}"><input type="hidden" name="id" value="{{ id }}">{%- endmacro %}
{% macro field(name, label, value='', type='text', required=false) -%}<label>{{ label }}<input name="{{ name }}" type="{{ type }}" value="{{ value if value is not none else '' }}" {% if required %}required{% endif %} {% if type=='number' %}min="0"{% endif %}></label>{%- endmacro %}
{% macro customer_form(c={}) -%}
{{ field('sirket_ismi','Şirket ismi',c.get('sirket_ismi',''),required=true) }}{{ field('sahis_adi','Şahıs adı',c.get('sahis_adi','')) }}{{ field('telefon','Telefon',c.get('telefon','')) }}{{ field('eposta','E-posta',c.get('eposta',''),type='email') }}{{ field('adres','Adres',c.get('adres','')) }}
{{ field('anlasilan_yemek_fiyati','Yemek fiyatı',c.get('anlasilan_yemek_fiyati','0')) }}{{ field('mesai_yemek_fiyati','Mesai fiyatı',c.get('mesai_yemek_fiyati','0')) }}{{ field('varsayilan_kisi_sayisi','Varsayılan kişi sayısı',c.get('varsayilan_kisi_sayisi','0'),type='number') }}{{ field('devreden_borc','Devreden borç',c.get('devreden_borc','0')) }}
<label class="check"><input type="checkbox" name="faturali_mi" {% if c.get('faturali_mi')=='1' %}checked{% endif %}> Faturalı müşteri</label><label class="check"><input type="checkbox" name="aktif_mi" {% if c.get('aktif_mi','1')=='1' %}checked{% endif %}> Aktif müşteri</label>
{%- endmacro %}
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bereket Sofram · Catering</title><link rel="stylesheet" href="{{ app_prefix }}/static/app.css">
<style>
body{background:#faf7f2;color:#253d34}main{max-width:1160px;margin:24px auto;padding:0 18px}header{background:#123f35;color:white;padding:18px 24px}header .top{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:1124px;height:auto;margin:auto;padding:0;background:transparent;border:0}header nav{display:flex;flex-wrap:wrap;gap:8px;max-width:1124px;margin:18px auto 0}header a{color:white;padding:8px 12px;border-radius:8px}header a[aria-current=page]{background:#cfad62;color:#123f35}h1{font-size:28px;margin:24px 0}h2{font-size:19px;margin:0 0 18px}.card{background:white;border:1px solid #e7e5dd;border-radius:16px;padding:22px;margin:18px 0;box-shadow:0 4px 16px #163d3510}.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px;align-items:end}label{display:block;font-size:13px;color:#53615c}input,select{display:block;width:100%;padding:10px;margin-top:6px;border:1px solid #d6ded8;border-radius:8px;background:white;color:#253d34}input[type=checkbox]{display:inline;width:auto}.check{padding:12px 0}button,.button{border:0;background:#123f35;color:white;padding:11px 16px;border-radius:8px;cursor:pointer;display:inline-block}.danger{background:#9c3441}.muted{color:#74847a;font-size:13px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}td,th{padding:12px 10px;border-bottom:1px solid #e7ece7;text-align:left;vertical-align:top}th{background:#eef3ed;white-space:nowrap}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.metric{background:#fff;padding:20px;border:1px solid #e7e5dd;border-bottom:3px solid #c99a3a;border-radius:12px}.metric strong{display:block;font-size:23px;margin-top:8px}.inline{display:inline-flex;gap:8px;align-items:center;flex-wrap:wrap}.actions{display:flex;gap:8px;flex-wrap:wrap}.search{max-width:420px}.badge{padding:3px 7px;background:#f8eccf;border-radius:6px}details summary{cursor:pointer;padding:8px 0}header form{margin:0}.chart{display:grid;grid-template-columns:repeat(12,minmax(45px,1fr));gap:6px;align-items:end;min-width:700px}.bar{background:#2b6b50;min-height:3px;border-radius:4px}.chart small{font-size:10px;white-space:nowrap}td input{min-width:75px}a{color:#195940}@media(max-width:600px){header{padding:14px}header nav{font-size:12px;gap:2px}header a{padding:6px}.card{padding:14px}h1{font-size:24px}}
</style></head><body><header><div class="top"><strong>🍽 Bereket Sofram <small>· Catering</small></strong><form action="{{ app_prefix }}/logout" method="post"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button>Çıkış</button></form></div><nav>{% for key,label in nav %}<a href="{{ url(key) }}" {% if page==key %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav></header><main>
{% if readonly %}<p class="card">Kontrol modu: veriler görüntülenir; kayıt değiştirme kapalıdır.</p>{% endif %}
{% if page in ['index','raporlama'] %}
<h1>{{ 'Sistem Özeti' if page=='index' else 'Raporlama' }}</h1>
{% if page=='raporlama' %}<form class="inline">{{ field('tarih','Gün',selected,'date') }}<button>Göster</button></form><h2>Seçilen gün</h2><div class="metrics">{% for label,key in [('Günlük ciro','revenue'),('Günlük gider','expenses'),('Günlük net','net')] %}<div class="metric">{{ label }}<strong>{{ daily_report[key]|money }}</strong></div>{% endfor %}<div class="metric">Normal / mesai yemek<strong>{{ daily_report.meal_count }} / {{ daily_report.overtime_count }}</strong></div></div>{% endif %}
<p class="muted">{{ period_start }} – {{ period_end }}{% if page=='index' %} · Önceki takvim ayı{% endif %}</p><div class="metrics">{% for label,key in [('Aylık ciro','revenue'),('Aylık gider','expenses'),('Aylık net','net')] %}<div class="metric">{{ label }}<strong>{{ month_report[key]|money }}</strong></div>{% endfor %}<div class="metric">{{ 'Ay sonu alacak' if page=='index' else 'Seçilen güne kadar alacak' }}<strong>{{ (month_report.receivables if page=='index' else daily_report.receivables)|money }}</strong></div><div class="metric">Aylık tahsilat<strong>{{ received|money }}</strong></div></div>
{% if page=='index' %}<section class="card"><div class="metrics"><div>Aktif müşteri<strong> {{ data.musteriler|selectattr('aktif_mi','equalto','1')|list|length }}</strong></div><div>Bugün normal yemek: {{ daily_report.meal_count }}</div><div>Bugün gider: {{ daily_report.expenses|money }}</div></div></section><section class="card scroll"><h2>Son 12 ay ciro</h2>{% set highest=chart|map(attribute='revenue')|max %}<div class="chart">{% for r in chart %}<div><small>{{ r.revenue|money }}</small><div class="bar" style="height:{{ (r.revenue/highest*150)|int if highest>0 else 3 }}px"></div><small>{{ r.month }}</small></div>{% endfor %}</div></section>{% endif %}
{% endif %}
{% if page=='musteriler' %}
<h1>Müşteri Yönetimi</h1><details class="card"><summary>Yeni müşteri ekle</summary><form method="post" class="form">{{ hidden('create') }}{{ customer_form() }}<button>Müşteriyi kaydet</button></form></details>
<div class="form"><label>Müşteri ara<input class="search" data-search placeholder="Firma veya telefon"></label><label>Sıralama<select data-sort><option value="new">Yeni kayıt</option><option value="old">Eski kayıt</option><option value="name">Firma A–Z</option><option value="name_desc">Firma Z–A</option><option value="debt">Borç çoktan aza</option><option value="paid">Ödeme çoktan aza</option></select></label></div>
{% for group,label in [('active','Aktif müşteriler'),('debt','Bırakılmış ama borcu olanlar')] %}<section class="card scroll"><h2>{{ label }}</h2><table><thead><tr><th>Firma</th><th>Hizmet + devir</th><th>Tahsilat</th><th>Açık borç</th><th>Fatura</th></tr></thead><tbody data-rows>{% for c in data.musteriler %}{% set b=balances[c.id] %}{% if (group=='active' and c.aktif_mi=='1') or (group=='debt' and c.aktif_mi!='1' and b.receivable>0) %}<tr data-row data-name="{{ c.sirket_ismi }}" data-id="{{ c.id }}" data-debt="{{ b.receivable }}" data-paid="{{ b.paid }}"><td><a href="{{ url('musteri_detay','?id='~c.id) }}">{{ c.sirket_ismi }}</a><div class="muted">{{ c.telefon or '' }} · {{ c.varsayilan_kisi_sayisi }} kişi</div></td><td>{{ b.service|money }}</td><td>{{ b.paid|money }}</td><td>{{ b.receivable|money }}</td><td><form method="post">{{ hidden('invoice',c.id) }}<input type="hidden" name="faturali_mi" value="{{ '0' if c.faturali_mi=='1' else '1' }}"><button>{{ 'Faturalı' if c.faturali_mi=='1' else 'Faturasız' }}</button></form></td></tr>{% endif %}{% endfor %}</tbody></table></section>{% endfor %}
{% endif %}
{% if page=='musteri_detay' %}{% set c=customer %}{% set b=balances[c.id] %}
<h1>{{ c.sirket_ismi }}</h1><div class="actions"><a class="button" href="{{ url('ekstre_olustur','?id='~c.id) }}">Ekstre oluştur</a><a href="{{ url('musteriler') }}">Müşterilere dön</a></div><div class="metrics"><div class="metric">Hizmet (KDV hariç) + devir<strong>{{ (b.legacy_detail_balance+b.paid)|money }}</strong></div><div class="metric">Tahsilat<strong>{{ b.paid|money }}</strong></div><div class="metric">Bakiye (KDV hariç)<strong>{{ b.legacy_detail_balance|money }}</strong></div></div>
<details class="card"><summary>Müşteri bilgilerini düzenle</summary><form class="form" method="post">{{ hidden('update',c.id) }}{{ customer_form(c) }}<button>Değişiklikleri kaydet</button></form></details>
<section class="card"><h2>Tahsilat ekle</h2><form method="post" class="form">{{ hidden('payment',c.id) }}{{ field('odeme_tarih','Tarih',today,'date',true) }}{{ field('odeme_tutar','Tutar','',required=true) }}{{ field('aciklama','Açıklama') }}<button>Ödemeyi kaydet</button></form></section>
<section class="card scroll"><h2>Yemek hizmet dökümü</h2><table><thead><tr><th>Tarih</th><th>Normal adet</th><th>Mesai adet</th><th>Normal tutar</th><th>Mesai tutar</th></tr></thead><tbody>{% for r in gunluk_yemek_verileri|sort(attribute='tarih',reverse=true) %}<tr><td>{{ r.tarih }}</td><td>{{ r.yemek_adedi }}</td><td>{{ r.mesai_yemek_adedi }}</td><td>{{ r.gunluk_toplam_tutar|money }}</td><td>{{ r.mesai_toplam_tutar|money }}</td></tr>{% endfor %}</tbody></table></section>
<section class="card scroll"><h2>Ödeme dökümü</h2><table><thead><tr><th>Tarih</th><th>Açıklama</th><th>Tutar</th></tr></thead><tbody>{% for r in tahsilatlar|sort(attribute='tarih',reverse=true) %}<tr><td>{{ r.tarih }}</td><td>{{ r.aciklama or '' }}</td><td>{{ r.tutar|money }}</td></tr>{% endfor %}</tbody></table></section>
<section class="card scroll"><h2>Ekstre geçmişi</h2><table><thead><tr><th>Ekstre</th><th>Dönem</th><th>Bakiye</th><th>İşlemler</th></tr></thead><tbody>{% for r in ekstreler %}<tr><td>EKS-{{ '%05d'|format(r.id|int) }}</td><td>{{ r.baslama_tarihi }} / {{ r.bitis_tarihi }}</td><td>{{ r.kalan_bakiye|money }}</td><td class="actions"><a href="{{ url('ekstre_pdf','?id='~r.id) }}" target="_blank">Özet PDF</a><a href="{{ url('ekstre_detay_pdf','?id='~r.id) }}" target="_blank">Detay PDF</a><form method="post" data-confirm="Bu ekstre geçmişten silinsin mi? Tahsilatlar korunur.">{{ hidden('delete_statement',c.id) }}<input type="hidden" name="ekstre_id" value="{{ r.id }}"><button class="danger">Sil</button></form></td></tr>{% endfor %}</tbody></table></section>
<details class="card"><summary>Müşteriyi sil</summary><p>Müşteri ile bağlı günlük yemek, tahsilat ve ekstre kayıtları silinir.</p><form method="post" data-confirm="Müşteri ve bağlı kayıtları kalıcı olarak silmek istiyor musunuz?">{{ hidden('delete',c.id) }}<input type="hidden" name="confirm" value="EVET"><button class="danger">Müşteriyi ve bağlı kayıtları sil</button></form></details>
{% endif %}
{% if page=='gunluk_giris' %}<h1>Günlük Yemek Girişi</h1><form class="inline">{{ field('tarih','Tarih',selected,'date') }}<button>Göster</button></form><div class="form"><label>Müşteri ara<input data-search></label><label>Sıralama<select data-sort><option value="name">Firma A–Z</option><option value="name_desc">Firma Z–A</option><option value="people_desc">Kişi çoktan aza</option><option value="people">Kişi azdan çoğa</option></select></label></div>
<form method="post">{{ hidden('save') }}<input type="hidden" name="tarih" value="{{ selected }}"><section class="card scroll"><table><thead><tr><th>Müşteri</th><th>Normal fiyat</th><th>Mesai fiyat</th><th>Yemek adedi</th><th>Mesai adedi</th></tr></thead><tbody data-rows>{% for c in data.musteriler|sort(attribute='sirket_ismi') if c.aktif_mi=='1' %}{% set r=daily.get(c.id,{}) %}<tr data-row data-name="{{ c.sirket_ismi }}" data-people="{{ c.varsayilan_kisi_sayisi }}"><td>{{ c.sirket_ismi }}{% if c.faturali_mi=='1' %} <span class="badge">Faturalı</span>{% endif %}</td><td>{{ c.anlasilan_yemek_fiyati|money }}</td><td>{{ c.mesai_yemek_fiyati|money }}</td><td><input aria-label="{{ c.sirket_ismi }} yemek" type="number" min="0" name="adet_{{ c.id }}" value="{{ r.get('yemek_adedi',c.varsayilan_kisi_sayisi) }}"></td><td><input aria-label="{{ c.sirket_ismi }} mesai" type="number" min="0" name="mesai_{{ c.id }}" value="{{ r.get('mesai_yemek_adedi','0') }}"></td></tr>{% endfor %}</tbody></table></section><button>Günlük kayıtları kaydet</button></form>{% endif %}
{% if page=='taziye_ekle' %}<h1>Taziye Yemeği (Tek Seferlik)</h1><section class="card"><p class="muted">Müşteri cari hesabına bağlanmaz.</p><form method="post" class="form">{{ hidden('create') }}{{ field('firma_adi','Firma / kişi','',required=true) }}{{ field('tarih','Tarih',today,'date',true) }}{{ field('adet','Yemek adedi','1','number',true) }}{{ field('birim_fiyat','Birim fiyat','0',required=true) }}{{ field('aciklama','Açıklama') }}<button>Kaydet</button></form></section>
<section class="card scroll"><h2>Taziye kayıtları · Genel toplam {{ data.taziye_yemekleri|sum_money('toplam_tutar')|money }}</h2><table><thead><tr><th>Tarih</th><th>Firma/kişi</th><th>Adet</th><th>Birim fiyat</th><th>Tutar</th><th></th></tr></thead><tbody>{% for r in (data.taziye_yemekleri|latest('tarih'))[:100] %}<tr><td>{{ r.tarih }}</td><td>{{ r.firma_adi }}<div class="muted">{{ r.aciklama or '' }}</div></td><td>{{ r.adet }}</td><td>{{ r.birim_fiyat|money }}</td><td>{{ r.toplam_tutar|money }}</td><td class="actions"><a href="{{ url('taziye_pdf','?id='~r.id) }}" target="_blank">PDF</a><form method="post" data-confirm="Taziye kaydı silinsin mi?">{{ hidden('delete',r.id) }}<button class="danger">Sil</button></form></td></tr>{% endfor %}</tbody></table></section>{% endif %}
{% if page in ['giderler','raporlama'] %}<h1>Günlük Giderler</h1>{% if page=='giderler' %}<form class="inline">{{ field('tarih','Tarih',selected,'date') }}<button>Göster</button></form>{% endif %}<section class="card"><form class="form" method="post">{{ hidden('create') }}<input type="hidden" name="tarih" value="{{ selected }}"><label>Kategori<select name="kategori">{% for c in categories %}<option>{{ c }}</option>{% endfor %}</select></label>{{ field('aciklama','Açıklama','',required=true) }}{{ field('tutar','Tutar','',required=true) }}<button>Gideri kaydet</button></form></section>
{% set costs=data.gunluk_giderler|selectattr('tarih','equalto',selected|string)|list %}<section class="card scroll"><h2>Toplam {{ costs|sum_money('tutar')|money }}</h2><table><thead><tr><th>Kategori</th><th>Açıklama</th><th>Tutar</th><th></th></tr></thead><tbody>{% for r in costs|reverse %}<tr><td>{{ r.get('kategori','Diğer') }}</td><td>{{ r.aciklama }}</td><td>{{ r.tutar|money }}</td><td><form method="post" data-confirm="Gider silinsin mi?">{{ hidden('delete',r.id) }}<input type="hidden" name="tarih" value="{{ selected }}"><button class="danger">Sil</button></form></td></tr>{% endfor %}</tbody></table><h2>Kategori toplamları</h2>{% for category,items in costs|groupby('kategori') %}<p>{{ category }}: {{ items|sum_money('tutar')|money }}</p>{% endfor %}</section>{% endif %}
{% if page=='calisanlar' %}<h1>Çalışanlar ve Maaş Giderleri</h1>{% set month=today.replace(day=1)|string %}{% set current=data.maas_odemeleri|selectattr('donem','equalto',month)|list %}<div class="metrics"><div class="metric">Aktif aylık maaş toplamı<strong>{{ data.calisanlar|selectattr('aktif','equalto','1')|list|sum_money('aylik_maas')|money }}</strong></div><div class="metric">Bu dönem ödenen<strong>{{ current|sum_money('tutar')|money }}</strong></div></div>
<section class="card"><h2>Çalışan ekle</h2><form method="post" class="form">{{ hidden('create') }}{{ field('ad_soyad','Ad soyad','',required=true) }}{{ field('gorev','Görev') }}{{ field('telefon','Telefon') }}{{ field('aylik_maas','Aylık maaş','0') }}{{ field('ise_giris_tarihi','İşe giriş','','date') }}<button>Çalışanı ekle</button></form></section>
<section class="card scroll"><h2>Çalışan listesi</h2><table><thead><tr><th>Çalışan</th><th>Görev</th><th>Maaş</th><th>Bu dönem ödenen</th><th>Durum</th></tr></thead><tbody>{% for c in data.calisanlar|sort(attribute='ad_soyad')|sort(attribute='aktif',reverse=true) %}<tr><td>{{ c.ad_soyad }}<div class="muted">{{ c.telefon or '' }}</div></td><td>{{ c.gorev or '' }}</td><td>{{ c.aylik_maas|money }}</td><td>{{ current|selectattr('calisan_id','equalto',c.id)|list|sum_money('tutar')|money }}</td><td><form method="post">{{ hidden('status',c.id) }}<input type="hidden" name="aktif" value="{{ '0' if c.aktif=='1' else '1' }}"><button>{{ 'Pasife al' if c.aktif=='1' else 'Aktif et' }}</button></form></td></tr>{% endfor %}</tbody></table></section>
<section class="card"><h2>Maaş / avans ödemesi</h2><form method="post" class="form"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="payment"><label>Çalışan<select name="id">{% for c in data.calisanlar if c.aktif=='1' %}<option value="{{ c.id }}">{{ c.ad_soyad }}</option>{% endfor %}</select></label>{{ field('donem','Ödeme dönemi',month,'date',true) }}{{ field('tarih','Ödeme tarihi',today,'date',true) }}{{ field('tutar','Tutar','',required=true) }}{{ field('aciklama','Açıklama') }}<button>Ödemeyi kaydet</button></form></section>
<section class="card scroll"><h2>Son 50 ödeme</h2><table><thead><tr><th>Çalışan</th><th>Dönem</th><th>Tarih</th><th>Açıklama</th><th>Tutar</th></tr></thead><tbody>{% for r in (data.maas_odemeleri|latest('tarih'))[:50] %}<tr><td>{% for c in data.calisanlar if c.id==r.calisan_id %}{{ c.ad_soyad }}{% endfor %}</td><td>{{ r.donem }}</td><td>{{ r.tarih }}</td><td>{{ r.aciklama or '' }}</td><td>{{ r.tutar|money }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}
{% if page=='ekstre_olustur' %}<h1>{{ customer.sirket_ismi }} · Ekstre Oluştur</h1><section class="card"><h2>1. Dönemi seç</h2><form class="form"><input type="hidden" name="id" value="{{ customer.id }}">{{ field('baslangic','Başlangıç',preview.baslama_tarihi if preview else today.replace(day=1),'date',true) }}{{ field('bitis','Bitiş',preview.bitis_tarihi if preview else today,'date',true) }}<button>Hesapla</button></form></section>{% if preview %}<section class="card"><h2>2. Kontrol et ve oluştur</h2><p>Yemek: {{ preview.normal_yemek_adedi }} adet · {{ preview.normal_yemek_tutari|money }}</p><p>Mesai: {{ preview.mesai_yemek_adedi }} adet · {{ preview.mesai_yemek_tutari|money }}</p><p>KDV: {{ preview.kdv_tutari|money }} · Dönem toplamı: {{ preview.donem_toplami|money }}</p><form method="post" class="form">{{ hidden('confirm',customer.id) }}<input type="hidden" name="baslangic" value="{{ preview.baslama_tarihi }}"><input type="hidden" name="bitis" value="{{ preview.bitis_tarihi }}">{{ field('onceki_bakiye','Önceki bakiye',preview.onceki_bakiye) }}{{ field('alinan_avans','Alınan avans',preview.alinan_avans) }}<button>Ekstreyi kaydet ve PDF aç</button></form><p class="muted">Kayıtlı dönem tahsilatının üzerindeki avans farkı ödeme olarak kaydedilir.</p></section>{% endif %}{% endif %}
</main><script>
document.querySelectorAll('[data-confirm]').forEach(f=>f.addEventListener('submit',e=>{if(!confirm(f.dataset.confirm))e.preventDefault()}));
document.querySelector('[data-search]')?.addEventListener('input',e=>{let q=e.target.value.toLocaleLowerCase('tr');document.querySelectorAll('[data-row]').forEach(r=>r.hidden=!r.textContent.toLocaleLowerCase('tr').includes(q))});
const sorter=document.querySelector('[data-sort]');function sortRows(){const mode=sorter.value;document.querySelectorAll('[data-rows]').forEach(body=>{let rows=[...body.querySelectorAll('[data-row]')];rows.sort((a,b)=>mode.startsWith('name')?(mode==='name_desc'?-1:1)*(a.dataset.name||'').localeCompare(b.dataset.name||'','tr'):mode==='people'?Number(a.dataset.people)-Number(b.dataset.people):mode==='people_desc'?Number(b.dataset.people)-Number(a.dataset.people):mode==='old'?Number(a.dataset.id)-Number(b.dataset.id):Number(b.dataset[mode==='new'?'id':mode]||0)-Number(a.dataset[mode==='new'?'id':mode]||0));rows.forEach(r=>body.appendChild(r))})}if(sorter){sorter.addEventListener('change',sortRows);sortRows()}
</script></body></html>
