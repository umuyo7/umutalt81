DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@db:5432/restaurant_catering
APP_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_HTTPS_ONLY=true
SESSION_TTL_HOURS=12
APP_PREFIX=/xyz
POSTGRES_DB=restaurant_catering
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME

# Bunlar örnektir; gerçek kullanıcı adlarını ve güçlü şifreleri siz seçin.
CATERING_USERNAME=catering
CATERING_PASSWORD=CHANGE_ME_CATERING_PASSWORD
RESTAURANT_USERNAME=restaurant
RESTAURANT_PASSWORD=CHANGE_ME_RESTAURANT_PASSWORD

# Orijinal PHP catering sistemi ve tek giriş bağlantısı
CATERING_SSO_SECRET=replace-with-another-long-random-secret
CATERING_DB_HOST=catering_db
CATERING_DB_NAME=bereket_catering
CATERING_DB_USER=bereket_user
CATERING_DB_PASSWORD=CHANGE_ME_CATERING_DB_PASSWORD
CATERING_DB_ROOT_PASSWORD=CHANGE_ME_CATERING_DB_ROOT_PASSWORD

# Mevcut MariaDB kullanan FastAPI catering bölümü; ilk kurulumda kapalı.
CATERING_NATIVE_ENABLED=false
CATERING_NATIVE_READONLY=true
CATERING_BACKEND=php

# Alan adı ayrımı: POS alanında catering/restoran muhasebe sayfaları açılmaz.
POS_HOST=pos.bereketsofram.com
MANAGEMENT_HOST=yonetim.bereketsofram.com
